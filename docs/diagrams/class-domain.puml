@startuml class-domain
title Trade Store - Domain Model

package "domain" {
  class IncomingTrade <<record>> {
    tradeId : String
    version : int
    counterPartyId : String
    bookId : String
    maturityDate : LocalDate
  }

  class Trade <<record>> {
    tradeId : String
    version : int
    counterPartyId : String
    bookId : String
    maturityDate : LocalDate
    createdDate : LocalDate
    expired : boolean
  }

  class TradeCommand <<record>> {
    messageId : String
    source : EventSource
    trade : IncomingTrade
  }

  class TradeHistoryEvent <<record>> {
    id : String
    tradeId : String
    version : int
    type : TradeEventType
    source : EventSource
    reason : String
    occurredAt : Instant
    payload : Map<String, Object>
  }

  class TradeFilter <<record>> {
    bookId : String
    counterPartyId : String
    expired : Boolean
  }
}

package "enums" {
  enum TradeEventType {
    CREATED
    UPDATED
    REPLACED
    REJECTED
    EXPIRED
  }

  enum EventSource {
    KAFKA
    REST
    SCHEDULER
  }

  enum SaveOutcome {
    CREATED
    UPDATED
    REPLACED
  }

  enum MessageOutcome {
    CREATED
    UPDATED
    REPLACED
    REJECTED_LOWER_VERSION
    REJECTED_MATURITY_IN_PAST
  }
}

package "exception" {
  abstract class TradeRejectedException {
    tradeId : String
    version : int
    outcome() : MessageOutcome
  }
  class LowerVersionTradeException
  class MaturityDateInPastException
  class RestExceptionHandler <<ControllerAdvice>> {
    maps exceptions to 400 / 404 / 409 / 422 / 429 / 503
  }
}

package "validation" {
  interface TradeValidationRule {
    validate(incoming : IncomingTrade, current : Optional<Trade>, today : LocalDate)
  }
  class MaturityDateRule <<Order 1>>
  class VersionRule <<Order 2>>
}

package "service" {
  package "ingestion" {
    class TradeProcessingService {
      process(command : TradeCommand) : SaveOutcome
    }
    class RejectionRecorder {
      record(command, rejection)
    }
  }
  package "expiry" {
    class ExpiryScheduler <<ShedLock>> {
      run()
    }
    class TradeExpiryService {
      expireNextBatch(today : LocalDate) : int
    }
  }
  package "outbox" {
    class OutboxWriter {
      append(tradeId, version, type, source, reason, payload)
    }
    class OutboxRelay <<ShedLock>> {
      deliverPendingEvents() : int
    }
    class TradeViewProjector <<MongoDB>> {
      apply(type : TradeEventType, payload : String)
    }
  }
  package "query" {
    class TradeQueryService {
      findTrade(tradeId) : Optional<Trade>
      findTrades(filter, pageable) : Page<Trade>
      findHistory(tradeId, pageable) : Page<TradeHistoryEvent>
      findTradesByBook(bookId, pageable) : Page<Trade>
    }
  }
  package "housekeeping" {
    class ProcessedMessagePurgeScheduler <<ShedLock>> {
      purgeExpiredRecords() : int
    }
  }
}

package "adapter" {
  package "kafka" {
    class TradeConsumer <<Kafka>> {
      onTrade(record : ConsumerRecord)
    }
  }
  package "rest.controller" {
    class TradeIngestionController <<REST>> {
      ingestTrade(request : TradeRequest, idempotencyKey : String) : ResponseEntity<IngestionResponse>
    }
    class TradeQueryController <<REST, read only>> {
      getTrades(bookId, counterPartyId, expired, pageable) : PageResponse<TradeResponse>
      getTrade(tradeId : String) : TradeResponse
      getTradeHistory(tradeId : String, pageable) : PageResponse<TradeEventResponse>
    }
    class BookQueryController <<REST, read only>> {
      getBookTrades(bookId : String, pageable) : PageResponse<TradeResponse>
    }
  }
  package "rest.ratelimit" {
    class IngestionLimitInterceptor <<HandlerInterceptor>> {
      preHandle() : 429 / 411 / 413
    }
    class ClientRateLimiter <<Bucket4j>> {
      tryAcquire(clientId : String) : Optional<Duration>
    }
  }
}

package "persistence" {
  package "sql.repository" {
    interface TradeJpaRepository <<PostgreSQL>>
    class TradeExpiryRepository <<PostgreSQL>>
    interface ProcessedMessageRepository <<PostgreSQL>>
    interface OutboxEventRepository <<PostgreSQL>>
  }
  package "mongo.repository" {
    interface TradeEventMongoRepository <<MongoDB>>
    interface TradeViewMongoRepository <<MongoDB>>
  }
}

package "observability" {
  class TradeMetrics <<Micrometer>>
  class OutboxBacklogMetrics <<MeterBinder>>
}

class "java.time.Clock\n(UTC)" as Clock

TradeRejectedException <|-- LowerVersionTradeException
TradeRejectedException <|-- MaturityDateInPastException
TradeRejectedException ..> MessageOutcome
TradeValidationRule <|.. MaturityDateRule
TradeValidationRule <|.. VersionRule
MaturityDateRule ..> MaturityDateInPastException : throws
VersionRule ..> LowerVersionTradeException : throws

TradeCommand --> IncomingTrade
TradeCommand --> EventSource
TradeHistoryEvent --> TradeEventType
TradeHistoryEvent --> EventSource

TradeConsumer --> TradeProcessingService
TradeIngestionController --> TradeProcessingService
TradeProcessingService --> "*" TradeValidationRule
TradeProcessingService --> TradeJpaRepository
TradeProcessingService --> ProcessedMessageRepository
TradeProcessingService --> OutboxWriter
TradeProcessingService --> RejectionRecorder
TradeProcessingService --> Clock
TradeProcessingService ..> SaveOutcome
RejectionRecorder --> ProcessedMessageRepository
RejectionRecorder --> OutboxWriter
OutboxWriter --> OutboxEventRepository
ExpiryScheduler --> TradeExpiryService
ExpiryScheduler --> Clock
TradeExpiryService --> TradeExpiryRepository
TradeExpiryService --> OutboxWriter
OutboxRelay --> OutboxEventRepository
OutboxRelay --> TradeEventMongoRepository
OutboxRelay --> TradeViewProjector
ProcessedMessagePurgeScheduler --> ProcessedMessageRepository
IngestionLimitInterceptor --> ClientRateLimiter
IngestionLimitInterceptor ..> TradeIngestionController : guards
TradeProcessingService --> TradeMetrics
OutboxBacklogMetrics --> OutboxEventRepository
BookQueryController --> TradeQueryService
TradeQueryController --> TradeQueryService
TradeQueryService --> TradeJpaRepository
TradeQueryService --> TradeEventMongoRepository
TradeQueryService --> TradeViewMongoRepository
RestExceptionHandler ..> TradeRejectedException : handles
@enduml
