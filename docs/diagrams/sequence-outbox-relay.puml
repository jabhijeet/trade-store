@startuml sequence-outbox-relay
title Trade Store - Outbox Relay

participant "Outbox Relay" as relay
participant "ShedLock" as shedlock
database "PostgreSQL\n(outbox_event)" as postgres
database "MongoDB" as mongo
queue "Kafka (trade-status)" as statusTopic

relay -> shedlock : acquire lock "outbox-relay"
alt lock held by another instance
  shedlock --> relay : skip poll
else lock acquired
  group MongoDB
    relay -> postgres : select events where mongo_delivered_at is null\norder by created_at limit batch
    loop for each event, until the first failure
      relay -> mongo : upsert trade_events (_id = event id)\n(projections planned)
      relay -> postgres : update set mongo_delivered_at
    end
  end
  group Kafka
    relay -> postgres : select EXPIRED events where kafka_delivered_at is null\norder by created_at limit batch
    loop for each event, until the first failure
      relay -> statusTopic : publish (key = tradeId),\nwait up to 10 s for ack
      relay -> postgres : update set kafka_delivered_at
    end
  end
  note right of relay
    each destination has its own query, batch and
    delivery column, so an outage of one never holds
    up the other; a failed delivery leaves its column
    null and is retried on the next poll; upserts by
    event id make retries idempotent
  end note
  relay -> shedlock : release lock
end
@enduml
